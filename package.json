{
  "name": "owlbear-rodeo-butler",
  "private": true,
  "version": "2.0.0",
  "description": "Owlbear Rodeo extension: creatures, D&D Beyond party, unit cards, initiative, HP and conditions for D&D 5E/5.5E",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "encounter:build": "tsx scripts/build-encounter.ts",
    "testmap": "tsx scripts/make-test-map.ts",
    "check:5etools": "tsx scripts/check-5etools.ts",
    "party:build": "tsx scripts/build-party.ts",
    "index:build": "tsx scripts/build-monster-index.ts",
    "test:smoke": "npm run build && playwright test"
  },
  "dependencies": {
    "@owlbear-rodeo/sdk": "3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "tsx": "4.19.4",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
